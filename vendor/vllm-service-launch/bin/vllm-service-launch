#!/usr/bin/env python3.12
"""Load the stateless vLLM launcher from source or its installed location."""

from pathlib import Path
import sys


script = Path(__file__).resolve()
candidates = (
    script.parents[1] / "lib",
    script.parents[1] / "lib" / "vllm-service-launch",
)
for library in candidates:
    if (library / "vllm_service_launch" / "cli.py").is_file():
        sys.path.insert(0, str(library))
        break
else:
    raise SystemExit("vllm-service-launch library is not installed")

from vllm_service_launch.cli import main


raise SystemExit(main())
