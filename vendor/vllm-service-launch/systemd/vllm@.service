[Unit]
Description=Transient vLLM service %i
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/vllm-service-launch run --service-id %i
ExecStopPost=/usr/local/bin/vllm-service-launch cleanup --service-id %i
Restart=no
KillMode=control-group
LimitMEMLOCK=infinity
TimeoutStopSec=120s
UMask=0077
